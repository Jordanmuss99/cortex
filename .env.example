# CORTEX -- Environment Configuration
# Copy this to .env and fill in your values

# -- Required --
# PostgreSQL with pgvector extension (Neon, Supabase, or local)
DATABASE_URL="postgresql://user:password@host:5432/cortex?sslmode=require"

# -- Embeddings (choose one) --
# Option A: VoyageAI (recommended, best quality)
VOYAGE_API_KEY="pa-..."

# Option B: OpenAI
# OPENAI_API_KEY="sk-..."

# -- LLM for Dream Summaries + Entity Extraction --
# Used for abstractive dream consolidation and semantic NER.
# Default provider: anthropic.
ANTHROPIC_API_KEY="sk-ant-..."
# CORTEX_LLM_PROVIDER="anthropic"  # anthropic | openai | openrouter | ollama | ollama_cloud | zhipu
# CORTEX_LLM_MODEL=""              # auto-detected per provider
# CORTEX_LLM_API_KEY=""            # provider override (falls back to ANTHROPIC_/OPENAI_/OPENROUTER_/ZHIPU_/OLLAMA_API_KEY)

# -- Optional: OpenAI-compatible base URL --
# For Ollama: set provider=openai and point here, or use provider=ollama.
# For GLM Cloud: use provider=zhipu (base URL is built-in).
# OPENAI_BASE_URL="http://localhost:11434/v1"

# -- Optional: LLM-based Entity Extraction --
# Set to "true" to use the configured LLM for semantic NER during ingest.
# Costs ~$0.001 per ingest call. Default: regex-only (free)
# CORTEX_LLM_ENTITIES="true"

# -- Optional: Workspace --
# CORTEX_WORKSPACE="/path/to/agent/workspace"

# -- Optional: Ollama (local embeddings + LLM) --
# OLLAMA_URL="http://localhost:11434"
# OLLAMA_API_KEY="ollama"  # OpenAI-compatible endpoint accepts any non-empty key
# EMBEDDING_PROVIDER="ollama"

# -- Optional: Ollama Cloud (subscription, OpenAI-compatible API) --
# Set provider=ollama_cloud. Defaults to https://ollama.com/v1.
# OLLAMA_CLOUD_URL="https://ollama.com/v1"
# OLLAMA_API_KEY="..."

# -- Optional: GLM Cloud (Zhipu AI) --
# ZHIPU_API_KEY="..."
