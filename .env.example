# CORTEX — Environment Configuration
# Copy this to .env and fill in your values

# ─── Required ─────────────────────────────────────────
# PostgreSQL with pgvector extension (Neon, Supabase, or local)
DATABASE_URL="postgresql://user:password@host:5432/cortex?sslmode=require"

# ─── Embeddings (choose one) ─────────────────────────
# Option A: VoyageAI (recommended, best quality)
VOYAGE_API_KEY="pa-..."

# Option B: OpenAI
# OPENAI_API_KEY="sk-..."

# ─── LLM for Dream Summaries + Entity Extraction ─────
# Used for abstractive dream consolidation and semantic NER
# Default provider: anthropic
ANTHROPIC_API_KEY="sk-ant-..."
# CORTEX_LLM_PROVIDER="anthropic"  # anthropic | openai | openrouter
# CORTEX_LLM_MODEL=""              # auto-detected per provider

# ─── Optional: LLM-based Entity Extraction ───────────
# Set to "true" to use Claude for semantic NER during ingest
# Costs ~$0.001 per ingest call. Default: regex-only (free)
# CORTEX_LLM_ENTITIES="true"

# ─── Optional: Workspace ─────────────────────────────
# CORTEX_WORKSPACE="/path/to/agent/workspace"

# ─── Optional: Ollama (local embeddings) ─────────────
# OLLAMA_URL="http://localhost:11434"
# EMBEDDING_PROVIDER="ollama"

# ─── MCP over Streamable HTTP (Superhuman Go Prompt Rewriter) ───
# Bearer token gating the read-only /mcp endpoint (cortex_search/recall/init only).
# If unset, the endpoint fails CLOSED and serves 401 to every request. Generate a
# distinct high-entropy value; never reuse another service's secret.
# CORTEX_MCP_TOKEN=""

# ─── OAuth 2.1 resource server (for OAuth-first MCP clients, e.g. the Gemini web app) ───
# The consumer Gemini app requires the MCP server to be an OAuth resource server: it returns
# 401 with WWW-Authenticate -> /.well-known/oauth-protected-resource, and validates that the
# access token was minted specifically for Cortex (audience binding). We do NOT hand-roll an
# authorization server — a MANAGED IdP (Auth0 / Stytch / Cloudflare Access / etc.) issues
# tokens; Cortex only VERIFIES them here. Leave unset to run static-bearer-only (Superhuman Go).
#
# Canonical MCP resource URI (also the expected token `aud`). Must match the public URL.
# CORTEX_MCP_PUBLIC_URL="https://cortex.obsidiannetwork.au/mcp"
# IdP issuer URL (must equal the token `iss`; becomes authorization_servers[0] in metadata).
# CORTEX_OAUTH_ISSUER="https://your-tenant.auth0.com/"
# Optional: JWKS URI. If unset it is discovered from <issuer>/.well-known/oauth-authorization-server.
# CORTEX_OAUTH_JWKS_URI=""

# ─── Optional: live AgentBridge session context in cortex_prompt_context ───
# OFF by default. When AGENTBRIDGE_MCP_URL is set, cortex_prompt_context also calls the
# AgentBridge read-only MCP endpoint (agentbridge_list_sessions + inspect_session) and
# merges live session context into the digest. Unset => memory-only. If set but the host
# is offline, the digest carries an explicit "host offline" note (never a silent gap).
# URL must target the /api/mcp route on the AgentBridge network connector.
# AGENTBRIDGE_MCP_URL="http://127.0.0.1:8765/api/mcp"
# AGENTBRIDGE_MCP_TOKEN=""            # = ~/.agentbridge/bridge_token.txt (Bearer)
# AGENTBRIDGE_MCP_TIMEOUT_MS="2500"   # per-call timeout before degrading to offline note
