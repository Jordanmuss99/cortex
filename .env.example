# CORTEX -- Environment Configuration
# Copy this to .env and fill in your values

# -- Required for a direct, non-Compose process --
# PostgreSQL with pgvector extension (Neon, Supabase, or local).
# A normal runtime URL must not be reused as an owner or OAuth credential.
DATABASE_URL="postgresql://user:password@host:5432/cortex?sslmode=require"

# -- Migration-first Docker deployment --
# Slice 13 is disposable/release-candidate only. Do not point these values at
# production until memory migration 010 is frozen by its independent plan.
# Give every credential a different password and keep owner/operator URLs out
# of normal runtime services.
CORTEX_DB_OWNER_USER="cortex"
CORTEX_DB_OWNER_PASSWORD=""
CORTEX_DB_NAME="cortex"
CORTEX_DATABASE_OWNER_URL=""
CORTEX_MEMORY_DATABASE_URL=""
MCP_OAUTH_DATABASE_URL=""
MCP_OAUTH_OPERATOR_DATABASE_URL=""

# Public OAuth authority. Keep these canonical values stable across rollout.
CORTEX_PUBLIC_BASE_URL="https://cortex.example.com"
CORTEX_OAUTH_ISSUER_URL="https://cortex.example.com"
CORTEX_OAUTH_RESOURCE_URL="https://cortex.example.com/mcp"

# Fixed bootstrap binding and gateway secrets. JWT secret must be at least 32
# UTF-8 bytes. Never put either secret in the operator/admin container.
MCP_OAUTH_USERNAME=""
MCP_OAUTH_AGENT_ID=""
MCP_OAUTH_PASSWORD=""
MCP_OAUTH_JWT_SECRET=""

# Required immutable release/build identity for headless services.
CORTEX_BUILD_ID=""

# Compose publishes only the gateway in the base stack, on IPv4 loopback.
# CORTEX_GATEWAY_PORT="8091"
# The admin override also publishes these raw services on IPv4 loopback only.
# CORTEX_ADMIN_DB_PORT="5432"
# CORTEX_ADMIN_REST_PORT="3100"
# CORTEX_ADMIN_MCP_PORT="8001"
# CORTEX_ADMIN_DASHBOARD_PORT="8099"

# The defaults below match the current installation. Override every one with a
# unique name for a disposable release-candidate drill; never reuse live state.
# CORTEX_EDGE_NETWORK_NAME="cortex-network"
# CORTEX_DB_VOLUME_NAME="cortex-pgdata"
# CORTEX_OAUTH_STATE_VOLUME_NAME="cortex_cortex-oauth-state"
# CORTEX_CRON_STATE_VOLUME_NAME="cortex_cortex-cron-state"

# -- Memory lifecycle runtime --
# `CORTEX_MEMORY_DATABASE_URL` above must use a separately provisioned login
# granted only `cortex_memory_runtime` (never an owner or OAuth login).
# CORTEX_INGEST_WORKER_CONCURRENCY="4"       # 1..32
# CORTEX_INGEST_MAX_ATTEMPTS="5"             # 1..20
# EMBEDDING_TIMEOUT_MS="20000"                # 1000..120000
# CORTEX_RETRIEVAL_CANDIDATE_LIMIT="100"      # 50..500
# CORTEX_RETRIEVAL_EVENT_RETENTION_DAYS="30"  # 7..365
# CORTEX_SYNTHESIS_ENABLED="false"

# -- Embeddings (choose one) --
# Option A: VoyageAI (recommended, best quality)
VOYAGE_API_KEY="pa-..."

# Option B: OpenAI
# OPENAI_API_KEY="sk-..."

# -- LLM for Dream Summaries + Entity Extraction --
# Used for abstractive dream consolidation and semantic NER.
# Default provider: anthropic.
ANTHROPIC_API_KEY="sk-ant-..."
# CORTEX_LLM_PROVIDER="anthropic"  # anthropic | openai | openrouter | ollama | ollama_cloud | zhipu
# CORTEX_LLM_MODEL=""              # auto-detected per provider
# CORTEX_LLM_API_KEY=""            # provider override (falls back to ANTHROPIC_/OPENAI_/OPENROUTER_/ZHIPU_/OLLAMA_API_KEY)

# -- Optional: OpenAI-compatible base URL --
# For Ollama: set provider=openai and point here, or use provider=ollama.
# For GLM Cloud: use provider=zhipu (base URL is built-in).
# OPENAI_BASE_URL="http://localhost:11434/v1"

# -- Optional: LLM-based Entity Extraction --
# Set to "true" to use the configured LLM for semantic NER during ingest.
# Costs ~$0.001 per ingest call. Default: regex-only (free)
# CORTEX_LLM_ENTITIES="true"

# -- Optional: Workspace --
# CORTEX_WORKSPACE="/path/to/agent/workspace"

# -- OAuth compatibility and login policy --
# OAuth login-cookie lifetime. The production Compose file safely obtains the
# browser IP through Cloudflare and reuses the opaque cookie only from that IP.
# MCP_OAUTH_LOGIN_SESSION_TTL_SECONDS="2592000"
# MCP_OAUTH_LOGIN_ATTEMPT_LIMIT="10"
# MCP_OAUTH_LOGIN_ATTEMPT_WINDOW_SECONDS="900"
# MCP_OAUTH_REGISTRATION_ATTEMPT_LIMIT="30"
# MCP_OAUTH_REGISTRATION_ATTEMPT_WINDOW_SECONDS="3600"
# Idempotent retry window for the immediately previous identical refresh (max 300s).
# MCP_OAUTH_REFRESH_RETRY_GRACE_SECONDS="30"
# Required by the staged database-authority gateway: an explicit timezone-
# qualified cutoff no more than 90 days in the future for sid-less v1 tokens.
# Keep the same timestamp after expiry; a past cutoff is the fail-closed state.
MCP_OAUTH_ACCEPT_LEGACY_UNTIL=""

# Upgrades and recovery require the existing read-only JSON state volume.
# Fresh install is an explicit assertion for a genuinely new, empty authority;
# it is never a missing-file or recovery fallback.
MCP_OAUTH_FRESH_INSTALL="0"

# Optional fixed clients. A non-empty secret makes the client confidential;
# secret bytes are verified in memory and are never persisted to PostgreSQL.
# LINEAR_OAUTH_CLIENT_ID="linear-cortex"
# LINEAR_OAUTH_CLIENT_SECRET=""
# LINEAR_OAUTH_REDIRECT_URI="https://linear.app/connect/mcp/callback"
# NOTION_OAUTH_CLIENT_ID="notion-cortex"
# NOTION_OAUTH_CLIENT_SECRET=""
# NOTION_OAUTH_REDIRECT_URI="https://app.notion.com/workflows/mcp/oauth/callback"

# -- Optional: Ollama (local embeddings + LLM) --
# OLLAMA_URL="http://localhost:11434"
# OLLAMA_API_KEY="ollama"  # OpenAI-compatible endpoint accepts any non-empty key
# EMBEDDING_PROVIDER="ollama"

# -- Optional: transcript reflection --
# The primary endpoint may be unauthenticated. A fallback is enabled only when
# REFLECT_FALLBACK_URL, REFLECT_FALLBACK_MODEL, and REFLECT_FALLBACK_KEY are all set.
# REFLECT_MODEL="qwen3-coder:30b"
# REFLECT_FALLBACK_URL="https://example.invalid/v1"
# REFLECT_FALLBACK_MODEL="fallback-model"
# REFLECT_FALLBACK_KEY="set-at-runtime"

# -- Optional: Ollama Cloud (subscription, OpenAI-compatible API) --
# Set provider=ollama_cloud. Defaults to https://ollama.com/v1.
# OLLAMA_CLOUD_URL="https://ollama.com/v1"
# OLLAMA_API_KEY="..."

# -- Optional: GLM Cloud (Zhipu AI) --
# ZHIPU_API_KEY="..."
