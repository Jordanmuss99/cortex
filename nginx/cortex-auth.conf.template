server {
    listen 8080;
    server_name _;

    client_max_body_size 20m;

    # Public health check only.
    location = /api/v1/health {
        proxy_pass http://cortex:3100/api/v1/health;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Authenticated MCP endpoint.
    location /mcp {
        if ($http_authorization != "Bearer ${CORTEX_API_TOKEN}") {
            add_header WWW-Authenticate 'Bearer realm="cortex"';
            return 401;
        }

        proxy_pass http://cortex-mcp:8000/mcp;
        proxy_http_version 1.1;

        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization $http_authorization;
    }

    # Authenticated REST API and root.
    location / {
        if ($http_authorization != "Bearer ${CORTEX_API_TOKEN}") {
            add_header WWW-Authenticate 'Bearer realm="cortex"';
            return 401;
        }

        proxy_pass http://cortex:3100;
        proxy_http_version 1.1;

        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization $http_authorization;
    }
}